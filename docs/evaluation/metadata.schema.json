{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NewsBrief public benchmark metadata",
  "type": "object",
  "required": [
    "id",
    "category",
    "title",
    "source_url",
    "published_at",
    "retrieved_at",
    "content_sha256",
    "usage_note"
  ],
  "properties": {
    "id": { "type": "string" },
    "category": { "enum": ["校园", "民生", "政策", "科技", "财经", "文化"] },
    "title": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "published_at": { "type": "string" },
    "retrieved_at": { "type": "string" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "usage_note": { "type": "string" }
  }
}
